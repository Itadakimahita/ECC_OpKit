        "tdd-workflow",
        "verification-loop"
      ],
      "commands": {
        "build": ["cargo build"],
        "test": ["cargo test"],
        "lint": ["cargo clippy -- -D warnings"],
        "format": ["cargo fmt"]
      },
      "permissions": {
        "allow": ["cargo build *", "cargo test *", "cargo clippy *", "cargo fmt *", "cargo run *", "cargo check *"],
        "deny": ["cargo publish"]
      }
    },
    {
      "id": "fastapi",
